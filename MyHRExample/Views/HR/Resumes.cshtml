@model List<Resume>
@{
    ViewData["Title"] = "HR — Резюме";
}

<link rel="stylesheet" href="~/css/pages.css" />

<div class="page">

    <div class="card-box wide">

        <div class="label-top">
            VELTORA HR
        </div>

        <h1>Отримані резюме</h1>

        <p class="description">
            Усі резюме зберігаються в Amazon S3. Посилання для перегляду діє 5 хвилин.
        </p>

        @if (Model.Count == 0)
        {
            <p class="description">Резюме ще немає.</p>
        }
        else
        {
            <table class="resume-table">
                <tr>
                    <th>Кандидат</th>
                    <th>Контакти</th>
                    <th>Файл</th>
                    <th>Дата завантаження</th>
                    <th></th>
                </tr>
                @foreach (var resume in Model)
                {
                    <tr>
                        <td>@resume.CandidateName</td>
                        <td>@resume.Contacts</td>
                        <td>
                            <a asp-action="Open" asp-route-key="@resume.Key" target="_blank">@resume.FileName</a>
                        </td>
                        <td>@resume.UploadedAt.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>
                            <form asp-action="Delete" method="post">
                                <input type="hidden" name="key" value="@resume.Key" />
                                <button type="submit" class="delete-button">Видалити</button>
                            </form>
                        </td>
                    </tr>
                }
            </table>
        }

    </div>

</div>
