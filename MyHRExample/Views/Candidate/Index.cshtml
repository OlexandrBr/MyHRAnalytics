@{
    ViewData["Title"] = "Кандидату";
}

<link rel="stylesheet" href="~/css/pages.css" />

<div class="page">

    <div class="card-box">

        <div class="label-top">
            VELTORA CAREERS
        </div>

        <h1>Надіслати резюме</h1>

        <p class="description">
            Вкажіть своє ім'я, контактні дані та додайте резюме у форматі PDF.
        </p>

        @if (ViewBag.Success == true)
        {
            <div class="message">Дякуємо! Резюме успішно надіслано.</div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="message error">@ViewBag.Error</div>
        }

        <form asp-action="Index" method="post" enctype="multipart/form-data">

            <div class="form-group">
                <label for="name">Ім'я</label>
                <input id="name" name="name" type="text" placeholder="Наприклад: Олександр Брузгін" required />
            </div>

            <div class="form-group">
                <label for="contacts">Контактні дані</label>
                <input id="contacts" name="contacts" type="text" placeholder="Email або телефон" required />
            </div>

            <div class="form-group">
                <label for="resume">Резюме (PDF)</label>
                <input id="resume" name="resume" type="file" accept="application/pdf" required />
            </div>

            <button type="submit" class="save-button">
                Надіслати резюме
            </button>

        </form>

    </div>

</div>
